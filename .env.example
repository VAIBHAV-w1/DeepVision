# DeepVision Environment Configuration Template
# Copy this file to .env and configure your environment-specific settings.
# DO NOT commit real secrets, credentials, or keys to version control.

# Django Core Settings (DJANGO_SECRET_KEY is required and must be unique in production)
DJANGO_SECRET_KEY=your_django_secret_key_here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DEEPVISION_HOST=127.0.0.1
DEEPVISION_PORT=8000

# Database Configuration
# Default (Embedded SQLite):
DATABASE_URL=sqlite:///instance/deepvision.db

# Supabase / PostgreSQL Configuration (Uncomment to use Supabase):
# USE_POSTGRES=True
# DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# SUPABASE_URL=https://[project-ref].supabase.co
# SUPABASE_ANON_KEY=your_supabase_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# SUPABASE_STORAGE_BUCKET_RECORDINGS=recordings
# SUPABASE_STORAGE_BUCKET_EVIDENCE=evidence

# Persistent Object / Volume Storage (auto: supabase -> s3 -> persistent_dir -> local)
# DEEPVISION_STORAGE_BACKEND=auto
# SUPABASE_STORAGE_BUCKET_RECORDINGS=deepvision-recordings
# SUPABASE_STORAGE_BUCKET_EVIDENCE=deepvision-evidence
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=deepvision-media
# S3_REGION=auto
# S3_ACCESS_KEY_ID=your_access_key_id
# S3_SECRET_ACCESS_KEY=your_secret_access_key
# DEEPVISION_PERSISTENT_STORAGE_DIR=/var/data/deepvision
# DEEPVISION_PURGE_LOCAL_AFTER_UPLOAD=true

# SMTP Settings (required for OTP delivery and enabled high/critical alert email)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_app_password_here
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_DEFAULT_SENDER=your_email@example.com
MAIL_TIMEOUT=8

# Twilio SMS Settings (Optional)
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here


# External Signed Uptime Monitor Webhook Secret (must match GitHub Actions secret UPTIME_INGEST_SECRET)
# UPTIME_INGEST_SECRET=replace_with_strong_random_hex_secret
# DEEPVISION_UPTIME_ALLOWED_HOSTS=vsw-deepvision.vercel.app,deepvision-6ie7.onrender.com

# Optional CLIP Scene Understanding (install requirements-clip.txt on local/edge hosts; keep False on low-RAM cloud tiers)
# DEEPVISION_CLIP_ENABLED=True
# DEEPVISION_CLIP_BACKEND=auto
# DEEPVISION_CLIP_MODEL=openai/clip-vit-base-patch32
# DEEPVISION_CLIP_DEVICE=auto
# DEEPVISION_CLIP_INTERVAL_SEC=5.0
# DEEPVISION_CLIP_COSINE_THRESHOLD=0.24
# DEEPVISION_CLIP_COOLDOWN_SEC=60.0
# DEEPVISION_CLIP_EMIT_ALERTS=false
