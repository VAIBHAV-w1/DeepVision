{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "x-vercel-toolbar",
          "value": "off"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://deepvision-6ie7.onrender.com/api/$1"
    },
    {
      "source": "/cameras/(.*)",
      "destination": "https://deepvision-6ie7.onrender.com/cameras/$1"
    },
    {
      "source": "/recordings/(.*)",
      "destination": "https://deepvision-6ie7.onrender.com/recordings/$1"
    },
    {
      "source": "/evidence/(.*)",
      "destination": "https://deepvision-6ie7.onrender.com/evidence/$1"
    },
    {
      "source": "/alerts/(.*)",
      "destination": "https://deepvision-6ie7.onrender.com/alerts/$1"
    },
    {
      "source": "/notifications/(.*)",
      "destination": "https://deepvision-6ie7.onrender.com/notifications/$1"
    },
    {
      "source": "/health(.*)",
      "destination": "https://deepvision-6ie7.onrender.com/health$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
